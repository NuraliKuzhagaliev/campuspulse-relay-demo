GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash
RELAY_AGENT_RESOURCE=
RELAY_STAGING_BUCKET=
RELAY_MCP_URL=
RELAY_GATEWAY_URL=
RELAY_AUTH_AUDIENCE=
RELAY_CONTEXT_SECRET=
RELAY_CALENDAR_ID=
RELAY_GITHUB_REPO=
RELAY_GITHUB_REF=main
RELAY_GITHUB_TOKEN=
RELAY_FIRESTORE_DATABASE=(default)
RELAY_STORAGE_BUCKET=
RELAY_OAUTH_CLIENT_ID=
RELAY_OAUTH_CLIENT_SECRET=
RELAY_TOKEN_ENCRYPTION_KEY=
RELAY_RUNTIME_SERVICE_ACCOUNT=
RELAY_SCHEDULER_IDENTITY=
RELAY_MODE=local
# Default illustrative/local route never loads a model key. Select one explicit live route.
RELAY_INFERENCE_PROVIDER=vertex
RELAY_DEPLOYMENT_MODE=local
RELAY_GEMINI_DEVELOPER_MODEL=gemini-3.5-flash-lite
RELAY_GEMINI_FREE_ONLY=false
# Server secret only; use scripts/gemini-env.ps1 for local DPAPI loading.
RELAY_GEMINI_API_KEY=
# Public verification key only; the owner private key remains encrypted on D:.
RELAY_AI_ADMIN_PUBLIC_KEY=
RELAY_MCP_SERVICE_SECRET=
RELAY_PUBLIC_AI_ENABLED=false
RELAY_MODEL_CALLS_PER_MINUTE=15
RELAY_MODEL_TOKENS_PER_MINUTE=250000
RELAY_MODEL_CALLS_PER_DAY=500
RELAY_POLL_SECONDS=300
RELAY_JUDGE_ENABLED=false
# Legacy non-public invitation route only; ignored by the public AI queue.
RELAY_REQUESTS_PER_MINUTE=8
RELAY_REQUESTS_PER_USER_DAY=100
RELAY_REQUESTS_TOTAL_DAY=300
RELAY_JUDGE_RESERVED_REQUESTS=100
# Optional LOCAL server-only public PR allowlist; public_demo ignores this expansion.
# RELAY_GATE_REPOS=pallets/flask
