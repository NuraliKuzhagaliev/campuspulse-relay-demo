FROM node:22-bookworm-slim AS frontend
WORKDIR /build
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
COPY public ./public
RUN npm run build

FROM python:3.13-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 RELAY_MODE=public_demo PORT=10000 \
    RELAY_DATA_DIR=/tmp/relay-demo XDG_CACHE_HOME=/tmp/relay-cache TMPDIR=/tmp
COPY requirements.public.lock.txt ./
RUN pip install --no-cache-dir -r requirements.public.lock.txt
COPY relay ./relay
COPY fixtures ./fixtures
COPY --from=frontend /build/dist ./dist
ARG RENDER_GIT_COMMIT
ENV RELAY_DEPLOYED_COMMIT=${RENDER_GIT_COMMIT}
RUN useradd -m -u 10001 relay
USER relay
CMD ["sh", "-c", "exec python -m uvicorn relay.gateway:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --no-access-log --proxy-headers"]
